---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import ContactForm from '../components/ContactForm.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { site } from '../data/site';

const title = 'Contato | Lobato Engenharia & Sistemas de Automação';
const description =
  'Fale com a Lobato Engenharia em Curitiba. Envie uma descrição do seu projeto de automação, elétrica, IoT ou TI pelo WhatsApp ou pelo formulário.';
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Contato' }];
---
<Base title={title} description={description}>
  <Navbar />
  <main id="conteudo">
    <PageHeader
      eyebrow="Contato"
      title="Fale com a Lobato"
      lead="Envie uma descrição inicial do projeto. Quanto mais contexto (cidade, tipo de instalação, situação atual e objetivo), mais direta é a orientação."
      crumbs={crumbs}
    />

    <section class="bg-canvas py-16 lg:py-24">
      <div class="container-rc grid lg:grid-cols-[1fr_1.25fr] gap-10 lg:gap-16 items-start">
        <!-- Canais -->
        <div class="reveal">
          <h2 class="font-heading font-bold text-xl text-ink">Canais diretos</h2>
          <p class="mt-3 text-body">O WhatsApp é o caminho mais rápido para uma primeira avaliação.</p>
          <ul class="mt-6 space-y-4">
            <li class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/10 text-brand-ink shrink-0"><Icon name="phone" class="w-5 h-5" /></span>
              <div>
                <p class="text-xs uppercase tracking-wide text-body">Telefone</p>
                <a href={`tel:${site.phoneDigits}`} data-location="contato" class="font-medium text-ink hover:text-brand-ink">{site.phoneDisplay}</a>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/10 text-brand-ink shrink-0"><Icon name="mail" class="w-5 h-5" /></span>
              <div>
                <p class="text-xs uppercase tracking-wide text-body">E-mail</p>
                <a href={`mailto:${site.email}`} data-location="contato" class="font-medium text-ink hover:text-brand-ink break-all">{site.email}</a>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/10 text-brand-ink shrink-0"><Icon name="pin" class="w-5 h-5" /></span>
              <div>
                <p class="text-xs uppercase tracking-wide text-body">Localização</p>
                <p class="font-medium text-ink">{site.city}, {site.regionName}</p>
              </div>
            </li>
            <li class="flex items-center gap-3">
              <span class="flex items-center justify-center w-11 h-11 rounded-xl bg-brand/10 text-brand-ink shrink-0"><Icon name="linkedin" class="w-5 h-5" /></span>
              <div>
                <p class="text-xs uppercase tracking-wide text-body">LinkedIn</p>
                <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="font-medium text-ink hover:text-brand-ink">Lobato Engenharia</a>
              </div>
            </li>
          </ul>
          <div class="mt-8">
            <WhatsAppButton location="contato" />
          </div>
        </div>

        <!-- Formulario -->
        <div class="reveal">
          <ContactForm />
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>
