---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import Icon from '../components/Icon.astro';
import { services } from '../data/site';
---
<Base title="Página não encontrada | Lobato Engenharia" noindex={true}>
  <Navbar />
  <main id="conteudo" class="bg-canvas">
    <section class="container-rc py-24 lg:py-32 text-center">
      <p class="font-heading font-bold text-brand-ink text-7xl">404</p>
      <h1 class="mt-4 font-extrabold" style="font-size:clamp(1.6rem,4vw,2.4rem)">Página não encontrada</h1>
      <p class="mt-4 text-lg max-w-md mx-auto">
        O endereço pode ter mudado ou não existe mais. Veja por onde seguir:
      </p>
      <div class="mt-8 flex flex-col sm:flex-row justify-center gap-3">
        <a href="/" class="btn-primary">Voltar ao início</a>
        <a href="/servicos/" class="btn-outline">Ver soluções</a>
      </div>

      <h2 class="sr-only">Páginas e soluções</h2>
      <div class="mt-12 flex flex-wrap justify-center gap-2.5">
        {services.map((s) => (
          <a href={`/servicos/${s.slug}/`} class="inline-flex items-center gap-2 rounded-full border border-line bg-surface px-4 py-2 text-sm font-medium text-ink hover:border-brand/40">
            <Icon name={s.icon} class="w-4 h-4 text-brand-ink" /> {s.title}
          </a>
        ))}
      </div>

      <div class="mt-12">
        <WhatsAppButton location="404" />
      </div>
    </section>
  </main>
  <Footer />
</Base>
