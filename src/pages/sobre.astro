---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import PageHeader from '../components/PageHeader.astro';
import About from '../components/About.astro';
import Process from '../components/Process.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import Icon from '../components/Icon.astro';

const title = 'Sobre a Lobato Engenharia & Sistemas de Automação | Curitiba';
const description =
  'A Lobato une engenharia, automação e tecnologia em projetos industriais, prediais e de infraestrutura, com sede em Curitiba. Conheça a empresa.';
const crumbs = [{ label: 'Início', href: '/' }, { label: 'Sobre' }];

const especializacoes = [
  { icon: 'factory', label: 'Automação industrial' },
  { icon: 'building', label: 'Automação predial' },
  { icon: 'home', label: 'Domótica' },
  { icon: 'network', label: 'Internet das Coisas (IoT)' },
  { icon: 'cpu', label: 'Indústria 4.0' },
  { icon: 'bolt', label: 'Elétrica predial' },
  { icon: 'server', label: 'Tecnologia da Informação' },
  { icon: 'layers', label: 'Telecomunicações' },
];
---
<Base title={title} description={description}>
  <Navbar />
  <main id="conteudo">
    <PageHeader
      eyebrow="Sobre"
      title="Sobre a Lobato"
      lead="Uma empresa que une engenharia, automação e tecnologia para integrar processos, equipamentos e informações."
      crumbs={crumbs}
    />
    <About withCta={false} />

    <section class="bg-surface py-20 lg:py-24">
      <div class="container-rc">
        <div class="max-w-2xl reveal">
          <span class="eyebrow">Especializações</span>
          <h2 class="mt-3 font-extrabold" style="font-size:clamp(1.6rem,4vw,2.4rem)">Áreas de conhecimento</h2>
          <p class="mt-4 text-lg">Frentes técnicas que a Lobato combina conforme a necessidade de cada projeto.</p>
        </div>
        <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-4 reveal">
          {especializacoes.map((e) => (
            <li class="flex items-center gap-3 rounded-xl2 border border-line bg-canvas p-5">
              <span class="flex items-center justify-center w-10 h-10 rounded-lg bg-brand/10 text-brand-ink shrink-0">
                <Icon name={e.icon} class="w-5 h-5" />
              </span>
              <span class="font-medium text-ink text-[15px]">{e.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <Process />
    <FinalCta />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>
