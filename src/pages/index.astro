---
import Base from '../layouts/Base.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import ProblemContext from '../components/ProblemContext.astro';
import Solutions from '../components/Solutions.astro';
import Process from '../components/Process.astro';
import About from '../components/About.astro';
import Audience from '../components/Audience.astro';
import Faq from '../components/Faq.astro';
import FinalCta from '../components/FinalCta.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import { faqs } from '../data/site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Base jsonLd={[faqLd]}>
  <Navbar />
  <main id="conteudo">
    <Hero />
    <ProblemContext />
    <Solutions />
    <Process />
    <About />
    <Audience />
    <Faq items={faqs} />
    <FinalCta />
  </main>
  <Footer />
  <FloatingWhatsApp />
</Base>
