---
import { differentials, flags, site } from '../data/site';
import Icon from './Icon.astro';
interface Props { withCta?: boolean; }
const { withCta = true } = Astro.props;
---
<section id="sobre" class="bg-canvas py-20 lg:py-28">
  <div class="container-rc grid lg:grid-cols-[1.1fr_1fr] gap-12 lg:gap-16 items-center">
    <div class="reveal">
      <span class="eyebrow">Sobre a Lobato</span>
      <h2 class="mt-3 font-extrabold" style="font-size:clamp(1.6rem,4vw,2.4rem)">Engenharia e tecnologia trabalhando juntas</h2>
      <p class="mt-5 text-lg leading-relaxed">
        A Lobato Engenharia &amp; Sistemas de Automação atua no desenvolvimento de soluções que unem engenharia, automação e tecnologia. Com sede em {site.city}, a empresa trabalha com diferentes áreas de integração para atender projetos industriais, prediais e de infraestrutura tecnológica.
      </p>
      <p class="mt-4 text-lg leading-relaxed">
        Cada projeto parte da necessidade real do cliente. O objetivo é construir uma solução coerente com a operação, o ambiente e as próximas etapas do negócio.
      </p>
      {flags.showFounded && (
        <p class="mt-4 text-sm font-semibold text-brand-ink">Atuação desde {site.foundedYear}.</p>
      )}
      {withCta && (
        <a href="/sobre/" class="mt-7 inline-flex items-center gap-1.5 font-semibold text-brand-ink hover:gap-2.5 transition-all">
          Conhecer a empresa <Icon name="arrow" class="w-4 h-4" />
        </a>
      )}
    </div>

    <div class="reveal">
      <div class="card p-7 lg:p-8">
        <h3 class="font-heading font-bold text-lg text-ink">Diferenciais</h3>
        <ul class="mt-5 space-y-3.5">
          {differentials.map((d) => (
            <li class="flex items-start gap-3">
              <span class="mt-0.5 flex items-center justify-center w-6 h-6 rounded-md bg-brand/10 text-brand-ink shrink-0">
                <Icon name="check" class="w-4 h-4" />
              </span>
              <span class="text-ink">{d}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</section>
