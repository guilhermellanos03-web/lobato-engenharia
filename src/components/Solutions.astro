---
import { services } from '../data/site';
import Icon from './Icon.astro';
interface Props { heading?: string; }
const { heading = 'Soluções conectadas à necessidade de cada projeto' } = Astro.props;
---
<section id="solucoes" class="bg-surface py-20 lg:py-28">
  <div class="container-rc">
    <div class="max-w-2xl reveal">
      <span class="eyebrow">Soluções</span>
      <h2 class="mt-3 font-extrabold" style="font-size:clamp(1.6rem,4vw,2.4rem)">{heading}</h2>
      <p class="mt-4 text-lg">
        Seis frentes de atuação que se integram entre si. O escopo de cada projeto é definido depois da análise da necessidade.
      </p>
    </div>

    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 reveal">
      {services.map((s) => (
        <a
          href={`/servicos/${s.slug}/`}
          class="group card p-6 flex flex-col transition-all hover:-translate-y-1 hover:border-brand/40"
        >
          <span class="flex items-center justify-center w-12 h-12 rounded-xl bg-brand/10 text-brand-ink">
            <Icon name={s.icon} class="w-6 h-6" />
          </span>
          <h3 class="mt-5 font-heading font-bold text-lg text-ink">{s.title}</h3>
          <p class="mt-2 text-[15px] leading-relaxed flex-1">{s.short}</p>
          <span class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-ink">
            Entender esta solução
            <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" />
          </span>
        </a>
      ))}
    </div>
  </div>
</section>
