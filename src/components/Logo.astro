---
// Logotipo PROVISORIO (marca tipografica + glifo de integracao).
// Substituir pelo logo oficial da Lobato quando fornecido (ver DADOS-PENDENTES.md).
interface Props { class?: string; tone?: 'auto' | 'light'; markOnly?: boolean; }
const { class: cls = '', tone = 'auto', markOnly = false } = Astro.props;
const uid = 'lg' + Math.random().toString(36).slice(2, 8);
const textCls = tone === 'light' ? 'text-white' : 'text-ink';
const subCls = tone === 'light' ? 'text-white/70' : 'text-body';
---
<span class={`inline-flex items-center gap-2.5 ${cls}`} aria-label="Lobato Engenharia e Sistemas de Automação">
  <svg width="38" height="38" viewBox="0 0 40 40" fill="none" aria-hidden="true" class="shrink-0">
    <rect width="40" height="40" rx="10" fill={`url(#${uid})`} />
    <!-- glifo: nos conectados (integracao de sistemas) -->
    <g stroke="#fff" stroke-width="1.8" stroke-linecap="round">
      <path d="M12 27 L12 16 L28 16" opacity="0.9" />
      <path d="M12 21 L22 21" opacity="0.55" />
    </g>
    <g fill="#fff">
      <circle cx="12" cy="27" r="2.6" />
      <circle cx="12" cy="16" r="2.6" />
      <circle cx="28" cy="16" r="2.6" />
      <circle cx="22" cy="21" r="2" opacity="0.8" />
    </g>
    <defs>
      <linearGradient id={uid} x1="0" y1="0" x2="40" y2="40" gradientUnits="userSpaceOnUse">
        <stop stop-color="#0874F9" />
        <stop offset="1" stop-color="#27B8E8" />
      </linearGradient>
    </defs>
  </svg>
  {!markOnly && (
    <span class="leading-none">
      <span class={`block font-heading font-bold text-[1.05rem] tracking-tight ${textCls}`}>Lobato</span>
      <span class={`block text-[0.62rem] font-semibold uppercase tracking-[0.16em] ${subCls}`}>Engenharia &amp; Automação</span>
    </span>
  )}
</span>
