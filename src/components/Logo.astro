---
interface Props { class?: string; tone?: 'auto' | 'light'; markOnly?: boolean; }
const { class: cls = '', tone = 'auto', markOnly = false } = Astro.props;
const blueSource = markOnly ? '/brand/simbolo-azul.png' : '/brand/logo-horizontal-azul.png';
const whiteSource = markOnly ? '/brand/simbolo-branco.png' : '/brand/logo-horizontal-branca.png';
const width = markOnly ? 72 : 362;
const height = markOnly ? 78 : 104;
const imageClass = markOnly ? 'h-9 w-auto' : 'h-10 sm:h-11 w-auto max-w-[210px] sm:max-w-[250px]';
const alt = markOnly ? 'Lobato Engenharia' : 'Lobato Engenharia e Sistemas de Automação';
---
<span class={`inline-flex items-center ${cls}`}>
  {tone === 'light' ? (
    <img src={whiteSource} width={width} height={height} alt={alt} class={`block object-contain object-left ${imageClass}`} loading="eager" decoding="async" />
  ) : (
    <>
      <img src={blueSource} width={width} height={height} alt={alt} class={`block object-contain object-left dark:hidden ${imageClass}`} loading="eager" decoding="async" />
      <img src={whiteSource} width={width} height={height} alt="" aria-hidden="true" class={`hidden object-contain object-left dark:block ${imageClass}`} loading="eager" decoding="async" />
    </>
  )}
</span>
