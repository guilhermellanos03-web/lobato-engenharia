---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  location: string;        // data-location (header, hero, services, final-cta, floating, footer)
  solution?: string;       // mensagem contextual do WhatsApp
  service?: string;        // data-service (slug), quando aplicavel
  variant?: 'primary' | 'outline' | 'ghost';
  label?: string;
  class?: string;
}
const {
  location,
  solution,
  service,
  variant = 'primary',
  label = 'Solicitar avaliação pelo WhatsApp',
  class: cls = '',
} = Astro.props;
const variantCls = variant === 'outline' ? 'btn-outline' : variant === 'ghost' ? 'btn-ghost' : 'btn-primary';
---
<a
  href={waLink(solution)}
  target="_blank"
  rel="noopener noreferrer"
  data-contact="whatsapp"
  data-location={location}
  data-service={service}
  class={`${variantCls} ${cls}`}
>
  <Icon name="whatsapp" class="w-5 h-5" />
  <span>{label}</span>
</a>
