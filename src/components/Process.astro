---
import { process } from '../data/site';
---
<section id="como-trabalhamos" class="bg-brand-deep text-white py-20 lg:py-28 relative overflow-hidden">
  <div class="absolute inset-0 opacity-[0.04]" aria-hidden="true" style="background-image:linear-gradient(#fff 1px,transparent 1px),linear-gradient(90deg,#fff 1px,transparent 1px);background-size:56px 56px"></div>
  <div class="container-rc relative">
    <div class="max-w-2xl reveal">
      <span class="eyebrow !text-brand-cyan">Processo Lobato</span>
      <h2 class="mt-3 font-extrabold text-white" style="font-size:clamp(1.6rem,4vw,2.4rem)">Do diagnóstico à entrega técnica</h2>
      <p class="mt-4 text-white/70 text-lg">
        Um caminho organizado para você saber o que esperar em cada etapa do projeto.
      </p>
    </div>

    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 reveal">
      {process.map((p, i) => (
        <li class="relative">
          <div class="flex items-center gap-3">
            <span class="font-heading text-4xl font-bold text-brand-cyan/40 leading-none">{p.n}</span>
            {i < process.length - 1 && <span class="hidden lg:block flex-1 h-px bg-white/15"></span>}
          </div>
          <h3 class="mt-4 font-bold text-lg text-white">{p.title}</h3>
          <p class="mt-2 text-white/65 text-[15px] leading-relaxed">{p.desc}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
