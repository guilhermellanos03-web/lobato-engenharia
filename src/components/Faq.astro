---
import Icon from './Icon.astro';
interface Props { items: { q: string; a: string }[]; heading?: string; eyebrow?: string; }
const { items, heading = 'Perguntas frequentes', eyebrow = 'FAQ' } = Astro.props;
---
<section id="faq" class="bg-canvas py-20 lg:py-28">
  <div class="container-rc max-w-3xl">
    <div class="reveal text-center">
      <span class="eyebrow">{eyebrow}</span>
      <h2 class="mt-3 font-extrabold" style="font-size:clamp(1.6rem,4vw,2.4rem)">{heading}</h2>
    </div>

    <div class="mt-10 divide-y divide-line border-y border-line reveal">
      {items.map((f) => (
        <details class="group py-2">
          <summary class="flex items-center justify-between gap-4 cursor-pointer list-none py-4 font-heading font-semibold text-ink">
            <span>{f.q}</span>
            <span class="flex items-center justify-center w-7 h-7 rounded-full bg-surface text-brand-ink shrink-0 transition-transform group-open:rotate-180">
              <Icon name="chevron" class="w-4 h-4" />
            </span>
          </summary>
          <p class="pb-5 pr-10 leading-relaxed">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
