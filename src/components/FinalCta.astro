---
import { site } from '../data/site';
import Icon from './Icon.astro';
import WhatsAppButton from './WhatsAppButton.astro';
interface Props { solution?: string; service?: string; }
const { solution, service } = Astro.props;
---
<section class="bg-brand-deep text-white py-20 lg:py-28 relative overflow-hidden">
  <div class="absolute inset-0" aria-hidden="true" style="background-image:radial-gradient(900px 500px at 50% 120%, rgba(39,184,232,.18), transparent 60%)"></div>
  <div class="container-rc relative max-w-3xl text-center reveal">
    <h2 class="font-extrabold text-white" style="font-size:clamp(1.7rem,4.5vw,2.6rem)">Vamos entender o que o seu projeto precisa?</h2>
    <p class="mt-5 text-white/75 text-lg leading-relaxed">
      Envie uma descrição inicial pelo WhatsApp. A equipe poderá avaliar o contexto e orientar os próximos passos.
    </p>
    <div class="mt-8 flex justify-center">
      <WhatsAppButton location="final-cta" solution={solution} service={service} />
    </div>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-sm text-white/80">
      <a href={`tel:${site.phoneDigits}`} data-location="final-cta" class="inline-flex items-center gap-2 hover:text-white">
        <Icon name="phone" class="w-4 h-4 text-brand-cyan" /> {site.phoneDisplay}
      </a>
      <a href={`mailto:${site.email}`} data-location="final-cta" class="inline-flex items-center gap-2 hover:text-white">
        <Icon name="mail" class="w-4 h-4 text-brand-cyan" /> {site.email}
      </a>
      <span class="inline-flex items-center gap-2">
        <Icon name="pin" class="w-4 h-4 text-brand-cyan" /> {site.city}, {site.regionName}
      </span>
      <a href={site.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white">
        <Icon name="linkedin" class="w-4 h-4 text-brand-cyan" /> LinkedIn
      </a>
    </div>
  </div>
</section>
