---
import Breadcrumbs from './Breadcrumbs.astro';
interface Crumb { label: string; href?: string; }
interface Props { eyebrow?: string; title: string; lead?: string; crumbs?: Crumb[]; }
const { eyebrow, title, lead, crumbs } = Astro.props;
---
<section class="bg-surface border-b border-line pt-10 pb-12 lg:pt-14 lg:pb-16">
  <div class="container-rc">
    {crumbs && <div class="mb-6"><Breadcrumbs items={crumbs} /></div>}
    {eyebrow && <span class="eyebrow">{eyebrow}</span>}
    <h1 class="mt-3 font-extrabold max-w-3xl" style="font-size:clamp(1.9rem,5vw,3rem)">{title}</h1>
    {lead && <p class="mt-5 text-lg leading-relaxed max-w-2xl">{lead}</p>}
  </div>
</section>
