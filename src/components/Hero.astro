---
import WhatsAppButton from './WhatsAppButton.astro';
import Icon from './Icon.astro';
const chips = ['Projetos personalizados', 'Atendimento consultivo', 'Curitiba, Paraná'];
---
<section class="relative overflow-hidden bg-brand-deep text-white">
  <div class="absolute inset-0" aria-hidden="true" style="background-image:radial-gradient(1100px 560px at 82% -20%, rgba(0,107,245,.20), transparent 62%), linear-gradient(180deg, #061A33 0%, #07223f 100%)"></div>

  <div class="container-rc relative py-14 sm:py-20 lg:py-24">
    <div class="grid lg:grid-cols-[1.05fr_.95fr] gap-10 lg:gap-14 items-center">
      <div class="reveal">
        <span class="eyebrow !text-brand-cyan">Engenharia, automação e integração de sistemas</span>
        <h1 class="mt-4 font-extrabold text-white leading-[1.08]" style="font-size:clamp(2.1rem,6vw,3.5rem)">
          Automação e engenharia para operações mais eficientes, seguras e conectadas.
        </h1>
        <p class="mt-5 text-white/75 leading-relaxed max-w-xl" style="font-size:clamp(1rem,2.4vw,1.15rem)">
          A Lobato desenvolve soluções em automação industrial e predial, IoT, elétrica, TI e telecomunicações para empresas e empreendimentos que precisam integrar processos, equipamentos e informações.
        </p>

        <div class="mt-8 flex flex-col sm:flex-row gap-3">
          <WhatsAppButton location="hero" />
          <a href="/servicos/" class="btn-ghost">Conhecer as soluções</a>
        </div>

        <ul class="mt-9 flex flex-wrap gap-x-6 gap-y-2.5">
          {chips.map((c) => (
            <li class="flex items-center gap-2 text-sm text-white/80">
              <Icon name="check" class="w-4 h-4 text-brand-cyan" />
              {c}
            </li>
          ))}
        </ul>
      </div>

      <figure class="reveal relative lg:justify-self-end w-full max-w-[560px] mx-auto">
        <div class="absolute -inset-4 rounded-[2rem] bg-brand/20 blur-2xl" aria-hidden="true"></div>
        <div class="relative overflow-hidden rounded-xl2 border border-white/15 shadow-2xl">
          <img
            src="/brand/hero-automacao-industrial.webp"
            width="1536"
            height="1024"
            alt="Profissional inspecionando painel de automação em ambiente industrial"
            class="parallax aspect-[4/3] w-full object-cover object-center"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-brand-deep/55 via-transparent to-transparent" aria-hidden="true"></div>
          <figcaption class="absolute bottom-4 left-4 right-4 rounded-xl border border-white/15 bg-brand-deep/75 px-4 py-3 text-sm text-white/85 backdrop-blur">
            Integração de processos, equipamentos e dados em uma única solução.
          </figcaption>
        </div>
      </figure>
    </div>
  </div>
</section>
