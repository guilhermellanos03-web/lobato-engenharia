---
import { nav } from '../data/site';
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import ThemeToggle from './ThemeToggle.astro';
import WhatsAppButton from './WhatsAppButton.astro';
const path = Astro.url.pathname;
const isActive = (href: string) => {
  if (href.includes('#')) return false; // links de ancora nao marcam pagina ativa
  if (href === '/') return path === '/';
  return path.startsWith(href);
};
---
<header class="sticky top-0 z-50 border-b border-line bg-canvas/85 backdrop-blur supports-[backdrop-filter]:bg-canvas/70">
  <div class="container-rc flex h-16 items-center justify-between gap-4">
    <a href="/" class="shrink-0">
      <Logo />
    </a>

    <nav aria-label="Principal" class="hidden lg:flex items-center gap-7">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'text-sm font-medium transition-colors hover:text-brand-ink',
            isActive(item.href) ? 'text-brand-ink' : 'text-body',
          ]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-2">
      <ThemeToggle />
      <WhatsAppButton location="header" label="Solicitar avaliação" class="hidden sm:inline-flex !px-4 !py-2.5 text-sm" />
      <button
        id="nav-toggle"
        type="button"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg border border-line text-ink"
        aria-label="Abrir menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" class="w-5 h-5" id="nav-icon-open" />
      </button>
    </div>
  </div>

  <!-- Menu mobile -->
  <div id="mobile-menu" hidden class="lg:hidden border-t border-line bg-canvas">
    <nav aria-label="Menu mobile" class="container-rc py-4 flex flex-col gap-1">
      {nav.map((item) => (
        <a
          href={item.href}
          class:list={[
            'rounded-lg px-3 py-3 text-base font-medium',
            isActive(item.href) ? 'text-brand-ink bg-surface' : 'text-ink hover:bg-surface',
          ]}
        >
          {item.label}
        </a>
      ))}
      <WhatsAppButton location="header" class="mt-2 w-full" />
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');
  const open = () => {
    menu!.hidden = false;
    btn!.setAttribute('aria-expanded', 'true');
    btn!.setAttribute('aria-label', 'Fechar menu');
  };
  const close = () => {
    menu!.hidden = true;
    btn!.setAttribute('aria-expanded', 'false');
    btn!.setAttribute('aria-label', 'Abrir menu');
  };
  btn?.addEventListener('click', () => (menu!.hidden ? open() : close()));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', close));
  // fecha ao voltar para desktop
  window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => { if (e.matches) close(); });
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
</script>
