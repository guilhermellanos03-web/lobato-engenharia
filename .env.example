# ------------------------------------------------------------------
# Lobato Engenharia - variaveis de ambiente (copie para .env)
# Nenhum ID e obrigatorio. O site funciona sem nenhum deles.
# NAO use IDs ficticios. Preencha apenas quando o cliente fornecer.
# ------------------------------------------------------------------

# URL publica do site (canonical / OG / sitemap).
# Em producao na Vercel use a URL da Vercel. Quando o dominio proprio
# resolver, troque para https://www.lobatoengenharia.com.br
PUBLIC_SITE_URL=https://lobato-engenharia.vercel.app

# Define noindex no site inteiro (true/false). Use "true" para esconder
# dos buscadores enquanto o cliente valida. Padrao: false (indexavel).
PUBLIC_NOINDEX=false

# WhatsApp (somente digitos, com DDI+DDD). Sobrescreve o numero do site.ts
# se precisar trocar sem mexer no codigo. Deixe vazio para usar o padrao.
PUBLIC_WHATSAPP=

# Google Analytics 4 - ex: G-XXXXXXXXXX
PUBLIC_GA4_ID=

# Google Ads - ex: AW-XXXXXXXXXX
PUBLIC_GOOGLE_ADS_ID=

# Microsoft Clarity - ex: xxxxxxxxxx
PUBLIC_CLARITY_ID=

# Meta Pixel - ex: 000000000000000
PUBLIC_META_PIXEL_ID=

# Google Search Console - conteudo da meta tag de verificacao
PUBLIC_GSC_VERIFICATION=
